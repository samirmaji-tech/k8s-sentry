# =====================================================================
# K8s-Sentry environment configuration (copy to .env and fill in)
# =====================================================================
# NOTE: .env is git-ignored. NEVER commit real secrets.

# ---- LLM (Anthropic) ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
LLM_MAX_TOKENS=1200

# ---- Slack ----
# Incoming webhook URL from https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/xxxxxxxxxxxxxxxxxxxxxxxx
# Set to "false" to disable Slack (agent still returns JSON over HTTP).
SLACK_ENABLED=true

# ---- Kubernetes scope ----
# Namespace the agent is allowed to inspect. Keep this tight.
TARGET_NAMESPACE=devops-lab
# How many log lines to pull per container (bounded to control cost + PII exposure).
LOG_TAIL_LINES=50

# ---- Agent behaviour ----
# read_only = agent only ever emits suggested commands, never executes them.
# This flag exists so the guardrail is explicit and auditable. Do not set to false.
AGENT_MODE=read_only
# Comma-separated pod phases/waiting-reasons treated as "unhealthy" when scanning.
UNHEALTHY_REASONS=CrashLoopBackOff,ImagePullBackOff,ErrImagePull,Error,CreateContainerConfigError,RunContainerError,OOMKilled

# ---- Server ----
LOG_LEVEL=INFO
